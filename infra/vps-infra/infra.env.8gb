# Profil resource VPS-INFRA — TUMBUH (VPS 8GB, pilot penuh hingga ~15 tenant).
# Pakai: docker compose --env-file infra.env.8gb up -d --build
# Muat aman ~15 sesi WhatsApp. Set WA_MAX_LIVE_SESSIONS=15 di apps/messaging-gateway/.env.
GW_MEM_LIMIT=6g
GW_SHM=1gb
MQTT_MEM_LIMIT=256m
BRIDGE_MEM_LIMIT=256m
