# messaging-gateway ENV (di VPS-INFRA)
# ⚠️ PRECEDENCE: bila app punya policyUrl (mis. /api/wa/policy), policy anti-ban di bawah DITIMPA
#    oleh InfraConfig DB app (di-pull tiap WA_POLICY_SYNC_MS). Ubah quiet/throttle → di DB, bukan sini.
#    Nilai di file ini = nilai AWAL / fallback saja. Lihat docs/infra/00_SSOT_Gateway_Architecture.md §4.
PORT=8080
# Registry app: JSON array. Tambah app baru = tambah entri (id, key rahasia, webhook, policyUrl opsional).
# Buat key acak kuat: `openssl rand -hex 24`
GATEWAY_APPS=[{"id":"aircon","key":"GANTI_dengan_key_acak_kuat","webhook":"https://aircon-peach.vercel.app/api/wa/callback","policyUrl":"https://aircon-peach.vercel.app/api/wa/policy"}]
# Interval pull policy dari policyUrl app (ms)
WA_POLICY_SYNC_MS=60000

# ============ ANTI-BAN (server NOTIFIKASI, bukan blasting) ============
# Laju kirim (jeda acak manusiawi + batas per menit / nomor)
WA_MIN_GAP_MS=6000
WA_MAX_GAP_MS=15000
WA_MAX_PER_MIN=8
# Plafon HARIAN per nomor (kunci anti-ban untuk notifikasi wajar)
WA_MAX_PER_DAY=200
# Warm-up nomor BARU (hari-1 pelan, naik bertahap selama N hari)
WA_WARMUP=1
WA_WARMUP_DAYS=7
WA_WARMUP_DAY1=20
# Jam tenang (jangan kirim tengah malam). Zona WIB = UTC+7.
WA_QUIET_START=21
WA_QUIET_END=7
WA_TZ_OFFSET=7

# ============ HEMAT RAM ============
# Batasi jumlah sesi Chromium hidup bersamaan; evict yang idle.
# VPS 4GB (default hemat): 6 sesi. VPS 8GB: naikkan ke 15. (selaras infra.env.<profil>)
WA_MAX_LIVE_SESSIONS=6
WA_IDLE_EVICT_MS=1800000
WA_TICK_MS=3000
WA_SESSION_DIR=/data/.wwebjs_auth
# Antrean pesan di-persist ke sini (tahan restart). Default: {WA_SESSION_DIR}/queue.json
# WA_QUEUE_FILE=/data/.wwebjs_auth/queue.json
# Timeout kirim per pesan (ms): getNumberId/sendMessage yang menggantung → failed, loop tetap hidup.
WA_SEND_TIMEOUT_MS=30000
