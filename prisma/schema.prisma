// AC Service Growth OS — Prisma schema
// Sumber: docs/BuildSpecPack_Part1_DataSchema_and_API.md + Auth_Decision v2
// Catatan: Postgres = Supabase. RLS diterapkan via migrasi SQL terpisah (tenant_id scoping).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================
enum Role {
  OWNER
  ADMIN
  TECHNICIAN
}

enum AuthProvider {
  GOOGLE
  PIN
}

enum TenantPlan {
  TRIAL
  PROFESSIONAL
  BUSINESS
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum CustomerSource {
  REFERRAL
  WHATSAPP
  WALK_IN
  MARKETING
  WEBSITE
  IOT_ALERT
  REPEAT
  OTHER
}

enum AssetType {
  SPLIT
  CASSETTE
  STANDING
  WINDOW
  CENTRAL
  OTHER
}

enum ServiceType {
  CLEANING
  REFILL_FREON
  REPAIR
  INSTALL
  DISMANTLE
  INSPECTION
  OTHER
}

enum JobStatus {
  DRAFT
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum JobSource {
  MANUAL
  REPEAT
  IOT
  LEAD
  WEBSITE
}

enum FeasibilityStatus {
  FEASIBLE
  RISK
  CONFLICT
  UNKNOWN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum ReminderStatus {
  QUEUED
  SENT
  CONVERTED
  DISMISSED
  EXPIRED
}

enum ReviewStatus {
  REQUESTED
  SENT
  RECEIVED
  DECLINED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  DONE
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
}

enum MessageChannel {
  WA
  PUSH
}

enum MessageDir {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  LOGGED
}

enum WaDriver {
  WEB
  META
}

enum DeviceProvision {
  UNPROVISIONED
  PROVISIONED
}

enum RentalStatus {
  NONE
  ACTIVE
  RETURNED
}

enum CommandState {
  COMMAND_SENT
  ACKNOWLEDGED
  STATE_CONFIRMED
  FAILED
}

enum AlertType {
  OVERCURRENT
  NO_COOLING
  OFFLINE
  SENSOR_FAULT
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACK
  RESOLVED
  DISMISSED
}

// ================= CORE =================
model Tenant {
  id                      String       @id @default(cuid())
  name                    String
  slug                    String       @unique
  phone                   String       @unique
  workingHoursDefault     Json
  serviceArea             Json
  bufferMinutes           Int          @default(15)
  maintenanceIntervalDays Int          @default(90)
  reminderLeadDays        Int          @default(7)
  plan                    TenantPlan   @default(TRIAL)
  status                  TenantStatus @default(TRIAL)
  trialEndsAt             DateTime?
  currentPeriodEnd        DateTime?
  nextDueDate             DateTime?
  suspendedAt             DateTime?
  markedForDeletionAt     DateTime?
  lastDunningReminderAt   DateTime?
  onboardingCompleted     Boolean      @default(false)
  waDriver                WaDriver     @default(WEB)
  publicProfile           Json?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  users        User[]
  customers    Customer[]
  assets       Asset[]
  technicians  Technician[]
  jobs         JobOrder[]
  subscription Subscription?
  payments     Payment[]
  invites      Invite[]
  iotOrders    IotOrder[]
}

model User {
  id           String       @id @default(cuid())
  tenantId     String
  name         String
  phone        String
  email        String?
  role         Role
  authProvider AuthProvider @default(PIN)
  pinHash      String?
  status       UserStatus   @default(INVITED)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  technician Technician?

  @@unique([tenantId, phone])
  @@index([tenantId, role])
}

model Customer {
  id           String         @id @default(cuid())
  tenantId     String
  name         String
  phone        String
  address      String?
  geoLat       Float?
  geoLng       Float?
  source       CustomerSource @default(OTHER)
  referredById String?
  notes        String?
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  assets Asset[]
  jobs   JobOrder[]

  @@index([tenantId, phone])
  @@index([tenantId, source])
}

model Asset {
  id                      String    @id @default(cuid())
  tenantId                String
  customerId              String
  brand                   String?
  model                   String?
  type                    AssetType @default(SPLIT)
  capacityPk              Float?
  roomLocation            String?
  serial                  String?
  installedAt             DateTime?
  maintenanceIntervalDays Int?
  nextServiceDate         DateTime?
  deviceId                String?   @unique
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  customer Customer   @relation(fields: [customerId], references: [id])
  jobs     JobOrder[]
  device   Device?    @relation(fields: [deviceId], references: [id])

  @@index([tenantId, customerId])
  @@index([tenantId, nextServiceDate])
}

model Technician {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String   @unique
  skills       String[]
  workingHours Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  user   User       @relation(fields: [userId], references: [id])
  jobs   JobOrder[]

  @@index([tenantId, active])
}

model JobOrder {
  id              String      @id @default(cuid())
  tenantId        String
  customerId      String
  assetId         String?
  technicianId    String?
  serviceType     ServiceType
  status          JobStatus   @default(DRAFT)
  source          JobSource   @default(MANUAL)
  scheduledDate   DateTime?
  windowStart     DateTime?
  windowEnd       DateTime?
  estDurationMin  Int         @default(60)
  addressSnapshot String?
  geoLat          Float?
  geoLng          Float?
  price           Decimal?    @db.Decimal(12, 2)
  notes           String?
  nextServiceDate DateTime?
  parentJobId     String?
  createdById     String
  completedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  customer   Customer           @relation(fields: [customerId], references: [id])
  asset      Asset?             @relation(fields: [assetId], references: [id])
  technician Technician?        @relation(fields: [technicianId], references: [id])
  events     JobProgressEvent[]
  photos     JobPhoto[]

  @@index([tenantId, status])
  @@index([tenantId, technicianId, scheduledDate])
  @@index([tenantId, customerId])
}

model JobProgressEvent {
  id            String     @id @default(cuid())
  tenantId      String
  jobId         String
  fromStatus    JobStatus?
  toStatus      JobStatus
  actorId       String
  at            DateTime   @default(now())
  clientEventId String?
  meta          Json?

  job JobOrder @relation(fields: [jobId], references: [id])

  @@unique([tenantId, clientEventId])
  @@index([tenantId, jobId, at])
}

model ChecklistTemplate {
  id          String      @id @default(cuid())
  tenantId    String
  serviceType ServiceType
  items       Json

  @@unique([tenantId, serviceType])
}

model ChecklistResult {
  id       String  @id @default(cuid())
  tenantId String
  jobId    String
  itemKey  String
  checked  Boolean @default(false)
  value    String?

  @@unique([tenantId, jobId, itemKey])
}

model JobPhoto {
  id       String   @id @default(cuid())
  tenantId String
  jobId    String
  kind     String
  url      String
  at       DateTime @default(now())

  job JobOrder @relation(fields: [jobId], references: [id])

  @@index([tenantId, jobId])
}

// ================= GROWTH =================
model Lead {
  id                  String         @id @default(cuid())
  tenantId            String
  name                String
  phone               String
  source              CustomerSource @default(OTHER)
  status              LeadStatus     @default(NEW)
  notes               String?
  followUpAt          DateTime?
  convertedCustomerId String?
  convertedJobId      String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, followUpAt])
}

model Referral {
  id                 String   @id @default(cuid())
  tenantId           String
  referrerCustomerId String
  referredCustomerId String
  at                 DateTime @default(now())
}

model ReviewRequest {
  id       String         @id @default(cuid())
  tenantId String
  jobId    String
  channel  MessageChannel @default(WA)
  status   ReviewStatus   @default(REQUESTED)
  at       DateTime       @default(now())
}

model RepeatReminder {
  id           String         @id @default(cuid())
  tenantId     String
  assetId      String
  dueDate      DateTime
  leadTimeDays Int
  status       ReminderStatus @default(QUEUED)
  jobId        String?
  sentAt       DateTime?

  @@unique([tenantId, assetId, dueDate])
  @@index([tenantId, status, dueDate])
}

model Campaign {
  id         String         @id @default(cuid())
  tenantId   String
  name       String
  segment    Json
  templateId String
  status     CampaignStatus @default(DRAFT)
  createdAt  DateTime       @default(now())
}

model CampaignRecipient {
  id         String          @id @default(cuid())
  tenantId   String
  campaignId String
  customerId String
  status     RecipientStatus @default(PENDING)
  sentAt     DateTime?

  @@unique([tenantId, campaignId, customerId])
}

// ================= MESSAGING =================
model MessageTemplate {
  id       String @id @default(cuid())
  tenantId String
  key      String
  body     String

  @@unique([tenantId, key])
}

model MessageLog {
  id          String         @id @default(cuid())
  tenantId    String
  customerId  String?
  jobId       String?
  channel     MessageChannel
  driver      WaDriver       @default(WEB)
  templateKey String?
  direction   MessageDir     @default(OUTBOUND)
  status      MessageStatus  @default(LOGGED)
  toPhone     String?
  body        String?
  at          DateTime       @default(now())

  @@index([tenantId, customerId, at])
  @@index([driver, status])
}

// ================= IoT =================
model Device {
  id              String          @id
  tenantId        String?
  assetId         String?         @unique
  provisionStatus DeviceProvision @default(UNPROVISIONED)
  rentalStatus    RentalStatus    @default(NONE)
  fwVersion       String?
  lastSeenAt      DateTime?
  health          Json?
  createdAt       DateTime        @default(now())

  asset     Asset?
  telemetry Telemetry[]
  commands  CommandLog[]

  @@index([tenantId, provisionStatus])
}

model Telemetry {
  id       BigInt   @id @default(autoincrement())
  deviceId String
  tenantId String?
  ts       DateTime
  tempC    Float?
  humidity Float?
  currentA Float?
  powerW   Float?
  online   Boolean  @default(true)

  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId, ts])
}

model CommandLog {
  id          String       @id @default(cuid())
  tenantId    String
  deviceId    String
  command     Json
  state       CommandState @default(COMMAND_SENT)
  evidence    Json?
  sentAt      DateTime     @default(now())
  ackAt       DateTime?
  confirmedAt DateTime?

  device Device @relation(fields: [deviceId], references: [id])

  @@index([tenantId, deviceId, sentAt])
}

model Alert {
  id           String        @id @default(cuid())
  tenantId     String
  deviceId     String
  assetId      String?
  type         AlertType
  severity     AlertSeverity @default(WARNING)
  status       AlertStatus   @default(OPEN)
  createdJobId String?
  at           DateTime      @default(now())

  @@index([tenantId, status])
}

// ================= BILLING =================
model Subscription {
  id                 String       @id @default(cuid())
  tenantId           String       @unique
  plan               TenantPlan
  iotDevices         Int          @default(0)
  status             TenantStatus @default(TRIAL)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean      @default(false)
  amountMonthly      Int          @default(0) // IDR snapshot harga saat berlangganan
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// Pembayaran langganan via Midtrans (Snap).
model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  orderId       String        @unique // order_id yang dikirim ke Midtrans
  plan          TenantPlan
  amount        Int // IDR
  status        PaymentStatus @default(PENDING)
  periodMonths  Int           @default(1)
  snapToken     String?
  snapRedirect  String?
  midtransTxId  String? // transaction_id dari Midtrans
  paymentType   String? // gopay, bank_transfer, dst
  paidAt        DateTime?
  rawNotif      Json? // payload webhook terakhir (audit)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([status, createdAt])
}

// Undangan user ke tenant (teknisi/admin) — invite-only, bukan self-signup.
model Invite {
  id         String       @id @default(cuid())
  tenantId   String
  role       Role         @default(TECHNICIAN)
  name       String
  phone      String
  token      String       @unique
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdById String
  createdAt  DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

// Super-admin platform (tim kita) — lintas tenant. Terpisah dari User tenant.
model PlatformAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Throttle brute-force login PIN teknisi (per nomor HP).
model LoginThrottle {
  key         String   @id // mis. phone ternormalisasi
  failedCount Int      @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime @updatedAt
}

// Profil perusahaan penyedia (Lumite) — untuk invoice/kwitansi & data merchant.
// Singleton (id="singleton"). EDITABLE admin, NO HARDCODE.
model CompanyProfile {
  id            String   @id @default("singleton")
  legalName     String   @default("")   // nama badan hukum, mis. "PT Lumite ..."
  brandName     String   @default("Aircon")
  logoUrl       String   @default("")   // URL/path logo untuk invoice & header
  isPkp         Boolean  @default(false) // Pengusaha Kena Pajak? menentukan boleh pungut PPN
  npwp          String   @default("")
  taxLabel      String   @default("PPN") // label pajak tampil (PPN / non-PKP kosongkan)
  email         String   @default("")
  phone         String   @default("")
  addressLine   String   @default("")
  city          String   @default("")
  province      String   @default("")
  postalCode    String   @default("")
  countryCode   String   @default("IDN")
  // Knob checkout (dari pola mesinviral):
  checkoutExpiryHours Int    @default(24)
  finishUrl           String @default("")
  updatedBy     String?
  updatedAt     DateTime @updatedAt
}


// ================= CONFIG (DB-DRIVEN, EDITABLE ADMIN — NO HARDCODE) =================

// Definisi paket langganan yang DAPAT DIUBAH lewat admin panel.
// Kuota null = UNLIMITED. Perubahan berlaku untuk tagihan berikutnya
// (Tenant menyimpan snapshot kuota saat aktivasi bila diperlukan).
model PlanConfig {
  id              String     @id @default(cuid())
  plan            TenantPlan @unique
  displayName     String
  priceMonthly    Int        @default(0) // IDR, belum termasuk pajak
  taxable         Boolean    @default(true)
  active          Boolean    @default(true)
  sortOrder       Int        @default(0)
  tagline         String?
  // Kuota (null = unlimited)
  maxAdmins       Int? // null = unlimited
  maxTechnicians  Int? // TERMASUK akun admin (sesuai aturan bisnis)
  maxCustomers    Int?
  maxAcUnits      Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// Kebijakan billing global (satu baris), DAPAT DIUBAH admin.
// Semua durasi/pajak/jadwal reminder tidak boleh hardcode.
model BillingPolicy {
  id                    String   @id @default("singleton")
  taxPercent            Float    @default(11) // PPN %
  trialDays             Int      @default(14)
  graceDaysBeforeSuspend Int     @default(1) // telat > N hari -> suspend (blok login)
  daysBeforeDelete      Int      @default(7) // telat > N hari -> hapus data tenant
  // Jadwal reminder WA (hari keterlambatan saat reminder dikirim), mis "0,1,3"
  dunningReminderDays   String   @default("0,1,3")
  deleteWarningDay      Int      @default(3) // reminder khusus peringatan hapus di hari ke-N
  updatedAt             DateTime @updatedAt
  updatedBy             String?
}

// ================= IoT PRODUK & PEMESANAN (jual putus) =================
enum IotOrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  INSTALLED
  CANCELLED
}

// Produk device IoT — harga & garansi DAPAT DIUBAH admin.
model IotProduct {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  description   String?
  priceUnit     Int // IDR per device (jual putus)
  warrantyDays  Int      @default(90)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders IotOrderItem[]
}

// Pesanan device IoT oleh tenant (jual putus) + progress + pembayaran.
model IotOrder {
  id            String         @id @default(cuid())
  tenantId      String
  orderNo       String         @unique
  status        IotOrderStatus @default(PENDING_PAYMENT)
  quantity      Int
  unitPrice     Int // snapshot harga saat order
  subtotal      Int
  taxPercent    Float          @default(0)
  taxAmount     Int            @default(0)
  total         Int
  // pembayaran (reuse pola Midtrans)
  paymentOrderId String?       @unique
  snapToken     String?
  snapRedirect  String?
  paidAt        DateTime?
  shippingAddress String?
  trackingNote  String?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  items  IotOrderItem[]

  @@index([tenantId, status])
}

model IotOrderItem {
  id         String     @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Int

  order   IotOrder   @relation(fields: [orderId], references: [id])
  product IotProduct @relation(fields: [productId], references: [id])
}
